# Copy to local.env and fill in. local.env is git-ignored.

# Claude chat painter (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional
# ANTHROPIC_MODEL=claude-opus-5-5       # claude-sonnet-5-5 costs about half
# ANTHROPIC_AGENT_EFFORT=medium         # low | medium | high
# ANTHROPIC_EFFORT=high                 # one-shot region painter

# Optional local vision model for the one-shot region painter (any OpenAI-compatible server)
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_API_KEY=
# LOCAL_LLM_MODEL=

# PAINTER_PORT=8517
